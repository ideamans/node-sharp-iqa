{
  "name": "sharp-iqa",
  "version": "1.0.0",
  "main": "dist/index.js",
  "description": "Image quality assessment utility for sharp. Now only MSE and PSNR.",
  "homepage": "https://github.com/ideamans/node-sharp-iqa",
  "scripts": {
    "test": "tsc && ava -v",
    "build": "tsc",
    "prepare": "npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "@ava/typescript": "^5.0.0",
    "@types/node": "^20",
    "ava": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "sharp": "^0.33.5"
  },
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "printWidth": 120
  },
  "ava": {
    "failFast": true,
    "timeout": "60s",
    "typescript": {
      "compile": "tsc",
      "rewritePaths": {
        "src/": "dist/"
      }
    },
    "files": [
      "!dist/**"
    ]
  }
}
